# ============================================================
# MeetExtract AI
# Environment Configuration Template
# ============================================================
#
# Copy this file to:
#
#     .env
#
# Never commit the real .env file.
# Never place real API keys or passwords in this file.
# ============================================================


# ============================================================
# APPLICATION
# ============================================================

APP_NAME=MeetExtract AI

APP_ENV=development

APP_DEBUG=true

APP_VERSION=1.0.0

# ============================================================
# SECURITY / AUTHENTICATION
# ============================================================

# Required: Generate a strong secret key for production (e.g., `openssl rand -hex 32`)
JWT_SECRET_KEY=generate-a-secure-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================================
# AI Configuration
# ============================================================
AI_PROVIDER="openai"
AI_API_KEY="your-openai-api-key"
AI_MODEL="gpt-4o-mini"

API_V1_PREFIX=/api/v1

LOG_LEVEL=INFO


# ============================================================
# BACKEND
# ============================================================

BACKEND_HOST=0.0.0.0

BACKEND_PORT=8000

BACKEND_RELOAD=true


# ============================================================
# FRONTEND
# ============================================================

FRONTEND_PORT=3000

NEXT_PUBLIC_API_URL=http://localhost:8000


# ============================================================
# DATABASE
# ============================================================

POSTGRES_DB=meetextract

POSTGRES_USER=meetextract

POSTGRES_PASSWORD=change_me

POSTGRES_HOST=postgres

POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://meetextract:change_me@postgres:5432/meetextract


# ============================================================
# AI PROVIDER
# ============================================================

# Provider abstraction should allow the AI provider to be
# changed without modifying the extraction business logic.

AI_PROVIDER=change_me

AI_MODEL=change_me

AI_API_KEY=change_me

AI_API_BASE_URL=


# Maximum time allowed for an AI request.

AI_REQUEST_TIMEOUT=60


# Number of retry attempts for recoverable AI failures.

AI_MAX_RETRIES=3


# ============================================================
# TRANSCRIPT PROCESSING
# ============================================================

# Maximum uploaded file size in bytes.

MAX_UPLOAD_SIZE_BYTES=10485760


# Maximum transcript text size processed by the application.

MAX_TRANSCRIPT_LENGTH=100000


# Supported file extensions.

SUPPORTED_FILE_EXTENSIONS=.txt,.pdf,.docx


# ============================================================
# STORAGE
# ============================================================

# Local development can use filesystem storage.
# Production may use S3-compatible object storage.

STORAGE_PROVIDER=local

STORAGE_BUCKET=meetextract

STORAGE_REGION=

STORAGE_ENDPOINT=

STORAGE_ACCESS_KEY=

STORAGE_SECRET_KEY=


# ============================================================
# REDIS
# ============================================================

REDIS_HOST=redis

REDIS_PORT=6379

REDIS_DB=0

REDIS_URL=redis://redis:6379/0


# ============================================================
# BACKGROUND PROCESSING
# ============================================================

WORKER_ENABLED=true

WORKER_CONCURRENCY=2


# ============================================================
# AUTHENTICATION
# ============================================================

# Replace this value with a cryptographically secure secret
# before running a non-development environment.

JWT_SECRET_KEY=change_me

JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=43200


# ============================================================
# CORS
# ============================================================

CORS_ORIGINS=http://localhost:3000


# ============================================================
# EVALUATION
# ============================================================

EVALUATION_ENABLED=true

EVALUATION_DATASET_PATH=data/evaluation


# ============================================================
# LOGGING / OBSERVABILITY
# ============================================================

LOG_AI_REQUESTS=false

LOG_TRANSCRIPT_CONTENT=false

LOG_SENSITIVE_DATA=false


# ============================================================
# DEVELOPMENT
# ============================================================

ENVIRONMENT=development

TESTING=false
